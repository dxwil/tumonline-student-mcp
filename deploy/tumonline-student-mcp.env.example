# Copy to /etc/tumonline-student-mcp.env and keep it mode 640, root:tumonline-mcp.
# Do not put a TUMonline token, a TUM password, or an MCP bearer token in this file.
# Each person signs in from their MCP client. This file only names the servers.

# HTTP listener. Keep this on loopback and publish the site with a reverse proxy.
TUMONLINE_MCP_TRANSPORT=http
TUMONLINE_MCP_HOST=127.0.0.1
TUMONLINE_MCP_PORT=8080
TUMONLINE_MCP_STATE_DIR=/var/lib/tumonline-student-mcp

# Public origin of the reverse proxy, with no path. This is the OAuth issuer.
# The process does not take the issuer from X-Forwarded-Proto or X-Forwarded-Host.
TUMONLINE_MCP_PUBLIC_URL=https://tumonline-mcp.kersys.lt

# TUMonline prefix. The default is the production campus host.
# TUMONLINE_MCP_BASE_URL=https://campus.tum.de/tumonline

# Name sent as pTokenName when a person requests a new Campus token.
# TUMONLINE_MCP_TOKEN_NAME=tumonline-student-mcp

# 32-byte AES-256-GCM key, base64 or 64 hex chars. If unset, the service creates
# /var/lib/tumonline-student-mcp/token.key on first use. Do not commit either form.
# TUMONLINE_MCP_TOKEN_KEY=

# Extra browser origins, comma-separated. Native clients omit Origin and are allowed.
# TUMONLINE_MCP_ALLOWED_ORIGINS=

# Hostnames the proxy may send, besides loopback and the public URL host.
# TUMONLINE_MCP_ALLOWED_HOSTS=

# Minimum gap between TUMonline calls for one user, and how many calls that user may make per minute.
# TUMONLINE_MCP_MIN_INTERVAL_MS=250
# TUMONLINE_MCP_USER_LIMIT=30
# TUMONLINE_MCP_TIMEOUT_MS=20000
